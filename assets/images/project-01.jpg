<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F8FAFC"/>
      <stop offset="100%" stop-color="#EEF2F6"/>
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#bg)"/>
  
  <!-- Browser Window Mockup -->
  <g transform="translate(60, 40)">
    <rect width="680" height="370" rx="12" fill="#FFFFFF" stroke="#E2E8F0" stroke-width="2" filter="drop-shadow(0 10px 25px rgba(0,0,0,0.05))"/>
    
    <!-- Window Bar -->
    <rect width="680" height="42" rx="12" fill="#F1F5F9"/>
    <rect y="30" width="680" height="12" fill="#F1F5F9"/>
    <circle cx="24" cy="21" r="5" fill="#EF4444"/>
    <circle cx="40" cy="21" r="5" fill="#F59E0B"/>
    <circle cx="56" cy="21" r="5" fill="#10B981"/>
    
    <!-- URL search box -->
    <rect x="140" y="10" width="400" height="22" rx="6" fill="#FFFFFF" stroke="#E2E8F0"/>
    <text x="340" y="25" fill="#64748B" font-family="system-ui, monospace" font-size="11" text-anchor="middle">https://website-sortir-slip-gaji.local</text>
    
    <!-- UI Layout Structure -->
    <rect x="30" y="65" width="180" height="24" rx="4" fill="#2563EB"/>
    <rect x="30" y="100" width="280" height="12" rx="3" fill="#CBD5E1"/>
    <rect x="30" y="120" width="200" height="12" rx="3" fill="#E2E8F0"/>
    
    <!-- Content Cards Wireframe -->
    <rect x="30" y="150" width="190" height="100" rx="8" fill="#F8FAFC" stroke="#E2E8F0"/>
    <rect x="45" y="170" width="60" height="10" rx="2" fill="#94A3B8"/>
    <rect x="45" y="190" width="100" height="18" rx="4" fill="#2563EB" opacity="0.85"/>
    <rect x="45" y="220" width="140" height="8" rx="2" fill="#CBD5E1"/>
    
    <rect x="245" y="150" width="190" height="100" rx="8" fill="#F8FAFC" stroke="#E2E8F0"/>
    <rect x="260" y="170" width="60" height="10" rx="2" fill="#94A3B8"/>
    <rect x="260" y="190" width="110" height="18" rx="4" fill="#3B82F6" opacity="0.85"/>
    <rect x="260" y="220" width="130" height="8" rx="2" fill="#CBD5E1"/>
    
    <!-- Data Table / Chart area -->
    <rect x="460" y="65" width="190" height="185" rx="8" fill="#F8FAFC" stroke="#E2E8F0"/>
    <rect x="480" y="85" width="100" height="12" rx="3" fill="#2563EB"/>
    <line x1="480" y1="120" x2="630" y2="120" stroke="#E2E8F0" stroke-width="2"/>
    <line x1="480" y1="150" x2="630" y2="150" stroke="#E2E8F0" stroke-width="2"/>
    <line x1="480" y1="180" x2="630" y2="180" stroke="#E2E8F0" stroke-width="2"/>
    <line x1="480" y1="210" x2="630" y2="210" stroke="#E2E8F0" stroke-width="2"/>
    
    <!-- Footer Caption -->
    <rect x="30" y="275" width="620" height="70" rx="8" fill="#F1F5F9"/>
    <text x="50" y="303" fill="#0F172A" font-family="system-ui, sans-serif" font-weight="700" font-size="16">Website Sortir Slip Gaji</text>
    <text x="50" y="326" fill="#2563EB" font-family="system-ui, sans-serif" font-weight="600" font-size="12">Teknologi: HTML, CSS, JavaScript</text>
  </g>
</svg>